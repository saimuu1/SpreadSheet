# Copy to .env and fill from your Supabase project (Project Settings).

# Settings → API → Project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Settings → API → Project API keys → anon / public
SUPABASE_ANON_KEY=your-anon-key

# Settings → API → Project API keys → service_role (SECRET — server only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Settings → API → JWT Settings → JWT Secret (used to verify Builder access tokens)
SUPABASE_JWT_SECRET=your-jwt-secret

# Settings → Database → Connection string → URI (use the pooler URI on port 6543,
# or the direct 5432 URI). asyncpg needs the postgresql:// scheme.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Storage bucket that holds raw uploaded CSVs (create it in the Supabase Storage UI).
STORAGE_BUCKET=raw-uploads

# Comma-separated frontend origins allowed by CORS (dev defaults shown).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
