# Copy to .env and fill from your Supabase project (Project Settings).

# Settings → API → Project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Settings → API → Project API keys → anon / public
SUPABASE_ANON_KEY=your-anon-key

# Settings → API → Project API keys → service_role (SECRET — server only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Settings → API → JWT Settings → JWT Secret (used to verify Builder access tokens)
SUPABASE_JWT_SECRET=your-jwt-secret

# Settings → Database → Connection string → URI (use the pooler URI on port 6543,
# or the direct 5432 URI). asyncpg needs the postgresql:// scheme.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Storage bucket that holds raw uploaded CSVs (create it in the Supabase Storage UI).
STORAGE_BUCKET=raw-uploads

# Comma-separated frontend origins allowed by CORS (dev defaults shown).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Stripe billing (test mode) ---
# Dashboard → Developers → API keys → Secret key (starts sk_test_...)
STRIPE_SECRET_KEY=sk_test_...
# The recurring Price id for the Pro plan (Product → Pricing → API ID, starts price_...)
STRIPE_PRICE_ID=price_...
# Webhook signing secret. Local: `stripe listen --forward-to localhost:8000/api/webhooks/stripe`
# prints one (whsec_...). Prod: from the webhook endpoint you add in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe returns the user after checkout / portal.
FRONTEND_URL=http://localhost:5173
